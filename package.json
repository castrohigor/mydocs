{
  "name": "mydocs",
  "version": "0.1.0",
  "description": "MyDocs — carteira de documentos com armazenamento no Google Drive",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "sync": "ng build && npx cap sync",
    "android": "ng build && npx cap sync android && npx cap open android",
    "ios": "ng build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome-team/capacitor-file-opener": "^8.1.0",
    "@capgo/capacitor-share-target": "^8.0.64",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@ionic/angular": "^9.0.9",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "sass": "^1.106.1",
    "typescript": "^6.0.3"
  }
}
